<UserControl x:Class="B_CurrencyConverterSQL.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="475" d:DesignWidth="1000">
    
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Label Grid.Column="0" Grid.ColumnSpan="3" Content="Currency Control" HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center" Width="1000" Height="50" FontWeight="Bold"
               FontSize="25" Foreground="#ec2075" />
        
        <Border Grid.Row="1" Grid.Column="1" Width="800" BorderThickness="0" CornerRadius="10" Height="120" Margin="0 10"
                Background="{StaticResource Standard.Background}"/>
        <Grid Grid.Row="1" Grid.Column="1" ShowGridLines="False" Margin="0 25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="1" Content="Currency Name : " FontSize="20" Foreground="White"/>
            <Label Grid.Row="0" Grid.Column="3" Content="Enter Amount : " FontSize="20" Foreground="White"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBoxName" FontSize="20" Margin="4" Width="225"
                     PreviewTextInput="TextBoxName_OnPreviewTextInput" PreviewKeyDown="TextBoxName_OnPreviewKeyDown"/>
            <TextBox Grid.Row="1" Grid.Column="3" x:Name="TextBoxAmount" FontSize="20" Margin="4" Width="225"
                     PreviewTextInput="TextBoxAmount_OnPreviewTextInput" PreviewKeyDown="TextBoxAmount_OnPreviewKeyDown"/>
            </Grid>
        
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Save" Click="SaveButton_OnClick" Style="{StaticResource ButtonRound}" x:Name="SaveButton" />
            <Button Content="Cancel" Click="CancelButton_OnClick" Style="{StaticResource ButtonRound}"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Grid.Column="1">
            
        </StackPanel>
        
        <DataGrid Grid.Row="3" Grid.Column="1" x:Name="DataGridCurrency" AutoGenerateColumns="False" Margin="10"
                  Background="Transparent" CanUserAddRows="False" SelectionUnit="Cell" VerticalScrollBarVisibility="Auto"
                  SelectedCellsChanged="DataGridCurrency_OnSelectedCellsChanged" HorizontalAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn Visibility="Hidden" Binding="{Binding Path=Id}"/>
                <DataGridTextColumn Header="Currency Name" Width="200" IsReadOnly="True" Binding="{Binding Path=Name}" FontSize="18"/>
                <DataGridTextColumn Header="Amount" Width="200" IsReadOnly="True" Binding="{Binding Path=Value}" FontSize="18"/>
        
                <DataGridTemplateColumn IsReadOnly="True" x:Name="Delete">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="/Images/delete.png" ToolTip="Delete" Width="25" Height="25" Margin="0 0 9 0" x:Name="Delete"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
        
                <DataGridTemplateColumn IsReadOnly="True" x:Name="Edit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="/Images/editing.png" ToolTip="Edit" Width="25" Height="25" Margin="5" x:Name="Edit"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        
        </DataGrid>
        
    </Grid>
    
</UserControl>
