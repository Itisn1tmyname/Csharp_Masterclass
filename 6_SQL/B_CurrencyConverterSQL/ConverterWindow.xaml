<UserControl x:Class="B_CurrencyConverterSQL.ConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:B_CurrencyConverterSQL"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        d:DesignHeight="475" d:DesignWidth="1000" IsVisibleChanged="ConverterWindow_OnIsVisibleChanged">
    
    <Grid ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="85"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Label Grid.Column="0" Grid.ColumnSpan="3" Content="Currency Converter" HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" Width="1000" Height="50" FontWeight="Bold"
                   FontSize="25" Foreground="#ec2075" />
            
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Label Content="Converted Currency" FontSize="20" HorizontalContentAlignment="Center" Width="1000"/>
                <Label x:Name="CurrencyResultLabel" FontSize="20" HorizontalContentAlignment="Center" Width="1000" Height="40"/>
            </StackPanel>
            
            <Border Grid.Row="2" Grid.Column="1"  CornerRadius="10" BorderThickness="0" Width="800"
                    Background="{StaticResource Standard.Background}"/>
            
            <Grid  Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Margin="0 25" 
                   ShowGridLines="False" Width="750">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="33"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Label Grid.Row="0" Grid.Column="0" Content="Enter Amount : " FontSize="20" Foreground="White"/>
                <Label Grid.Row="0" Grid.Column="2" Content="From : " FontSize="20" Foreground="White"/>
                <Label Grid.Row="0" Grid.Column="6" Content="To : " FontSize="20" Foreground="White"/>
                
                <TextBox x:Name="CurrencyTxtBx" Grid.Row="1" Grid.Column="0" Margin="4 0" 
                         FontSize="20" PreviewKeyDown="CurrencyTxtBx_OnTextInput"/>
                <ComboBox x:Name="FromComboBox" Grid.Row="1" Grid.Column="2"  FontSize="20" Margin="4 0"
                          MaxDropDownHeight="160"/>
                <fa:ImageAwesome Grid.Row="1" Grid.Column="4" Icon="Exchange" Height="30" Width="30" Foreground="White"/>
                <ComboBox x:Name="ToComboBox" Grid.Row="1" Grid.Column="6"  FontSize="20" Margin="4 0"
                          MaxDropDownHeight="160" Background="White"/>
                
            </Grid>
            
            
            <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <Button Content="Convert" Click="ConvertButton_OnClick"
                        Style="{StaticResource ButtonRound}"/>
                    <!-- See App.xaml -->
                
                <Button Content="Clear" Click="ClearButton_OnClick"
                        Style="{StaticResource ButtonRound}"/>
            </StackPanel>
            
        </Grid>
</UserControl>
