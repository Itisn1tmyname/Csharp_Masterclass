<Window x:Class="B_CurrencyConverterSQL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:B_CurrencyConverterSQL"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Currency Converter" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" >
    
    <TabControl x:Name="tabMain" TabStripPlacement="Top">
        <TabItem x:Name="tabConverter" Header=" Currency Converter ">
            <ContentControl x:Name="ConverterContent"/>
        </TabItem>
        <TabItem x:Name="tabControl" Header=" Currency Control ">
            <ContentControl x:Name="ControlContent"/>
        </TabItem>
    </TabControl>
    
    
</Window>
