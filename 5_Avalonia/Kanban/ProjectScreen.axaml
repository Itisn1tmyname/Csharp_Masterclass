<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" MinWidth="1200" MinHeight="800"
             x:Class="Kanban.ProjectScreen">
    <Grid ColumnSpacing="10" RowSpacing="10" Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <Label Grid.ColumnSpan="2" x:Name="ProjektLabel" Content="Projekt: " FontSize="24"/>
        <Button Grid.Row="0" Grid.Column="4" Content="Projekt Speichern" Classes="project" Click="SpeichernButton_OnClick"/>
        
        
        <Label Grid.Row="1" Grid.Column="0" Content="Todo: " FontSize="20"/>
        <Label Grid.Row="1" Grid.Column="2" Content="Doing: " FontSize="20"/>
        <Label Grid.Row="1" Grid.Column="4" Content="Done: " FontSize="20"/>
        
        <ListBox Grid.Row="2" Grid.Column="0" x:Name="ToDoListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Row="2" Grid.Column="2" x:Name="DoingListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Row="2" Grid.Column="4" x:Name="DoneListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
            <Button Content="→" Classes="project" FontSize="26" Click="DoToDoingButton_OnClick"/>
            <Button Content="←" Classes="project" FontSize="26" Click="DoingToDoButton_OnClick"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="3" Spacing="10" VerticalAlignment="Center">
            <Button Content="→" Classes="project" FontSize="26" Click="DoingToDoneButton_OnClick"/>
            <Button Content="←" Classes="project" FontSize="26" Click="DoneToDoingButton_OnClick"/>
        </StackPanel>
        
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="ItemTextBox" VerticalContentAlignment="Center" FontSize="20"/>
        <Button Grid.Row="3" Grid.Column="4" Content="Hinzufügen" Classes="project" Click="HinzufuegenButton_OnClick"/>
    
    </Grid>
</UserControl>
