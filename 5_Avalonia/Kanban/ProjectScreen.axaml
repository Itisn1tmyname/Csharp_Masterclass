<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Width="1350" MinHeight="800"
             x:Class="Kanban.ProjectScreen">
    <Grid ColumnSpacing="10" RowSpacing="10" Margin="25" x:Name="ProjectGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <Label Grid.ColumnSpan="2" x:Name="ProjektLabel" Content="Projekt: " FontSize="24"/>
        
        <Label Grid.Row="1" Grid.Column="0" Content="Todo: " FontSize="20" VerticalAlignment="Bottom"/>
        <Label Grid.Row="1" Grid.Column="2" Content="Doing: " FontSize="20" VerticalAlignment="Bottom"/>
        <Label Grid.Row="1" Grid.Column="4" Content="Done: " FontSize="20" VerticalAlignment="Bottom"/>
        
        <ListBox Grid.Row="2" Grid.Column="0" x:Name="ToDoListBox" SelectionChanged="ToDoListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Row="2" Grid.Column="2" x:Name="DoingListBox" SelectionChanged="DoingListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Row="2" Grid.Column="4" x:Name="DoneListBox" SelectionChanged="DoneListBox_OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
            <Button Content="→" Classes="project" FontSize="26" Click="DoToDoingButton_OnClick" Height="30"/>
            <Button Content="←" Classes="project" FontSize="26" Click="DoingToDoButton_OnClick" Height="30"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="3" Spacing="10" VerticalAlignment="Center">
            <Button Content="→" Classes="project" FontSize="26" Click="DoingToDoneButton_OnClick" Height="30"/>
            <Button Content="←" Classes="project" FontSize="26" Click="DoneToDoingButton_OnClick" Height="30"/>
        </StackPanel>
        
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="ItemTextBox" VerticalContentAlignment="Center"
                 FontSize="20"/>
        <Button Grid.Row="3" Grid.Column="4" Content="Hinzufügen" Classes="project" Click="HinzufuegenButton_OnClick" x:Name="HinzufuegenButton"/>
        
        <Button Grid.Row="4" Grid.Column="0" Content="Eintrag löschen" Classes="project" Click="EintragLoeschenButton_OnClick"/>
        <Button Grid.Row="4" Grid.Column="2" Content="Projekt Speichern" Classes="project" Click="SpeichernButton_OnClick"/>
        <Button Grid.Row="4" Grid.Column="4" Content="Projekt verlassen" Classes="project" Click="ProjektVerlassenButton_OnClick"/>
        
    
    </Grid>
</UserControl>
